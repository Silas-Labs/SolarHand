# SolarHand — Docker Compose configuration.
# Copy to `.env` (docker compose reads it automatically): cp .env.example .env

# Secret used to sign JWTs. CHANGE THIS for anything beyond a local demo.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOLARHAND_JWT_SECRET_KEY=demo-insecure-secret-change-me

# Cross-origin allowlist for the API. Unused by the bundled PWA (it calls /api
# on its own origin); set only if a separate front-end origin hits the API.
SOLARHAND_CORS_ORIGINS=http://localhost:8080

# Telemetry gateway secret. Connected devices (and the demo simulator) send this
# in the `X-Gateway-Key` header to POST /telemetry. Change for anything public.
SOLARHAND_GATEWAY_KEY=dev-gateway-key-change-me

# Host ports.
WEB_PORT=8080   # PWA (nginx)      -> http://localhost:8080
API_PORT=8000   # API (direct)     -> http://localhost:8000/docs
