{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/users/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/companies/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/assets/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/jobs/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/readings/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/faults/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/analytics/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/sync/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/audit/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/health", "destination": "/backend/app/main.py" },
    { "source": "/docs", "destination": "/backend/app/main.py" },
    { "source": "/openapi.json", "destination": "/backend/app/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}