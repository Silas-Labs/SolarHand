# Base URL the PWA prepends to every API call.
# Dev:  point at the locally running FastAPI server (CORS is enabled there),
#       e.g. http://localhost:8000
# Prod: use "/api". The PWA is served by nginx, which reverse-proxies /api/* to
#       the backend (stripping the /api prefix). A bare same-origin ("") is not
#       possible because /assets, /jobs and /sync are also client-side routes.
VITE_API_BASE=http://localhost:8000
