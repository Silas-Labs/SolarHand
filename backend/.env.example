# ─────────────────────────────────────────────────────────────
# SolarHand backend — environment configuration (EXAMPLE)
# Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# Free-form app metadata
SOLARHAND_ENVIRONMENT=development

# Database. SQLite by default (zero-setup for the hackathon demo).
# Postgres-ready: swap in e.g.
#   SOLARHAND_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/solarhand
SOLARHAND_DATABASE_URL=sqlite:///./solarhand.db

# JWT signing. GENERATE A REAL SECRET for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SOLARHAND_JWT_SECRET_KEY=dev-only-insecure-change-me
SOLARHAND_JWT_ALGORITHM=HS256
SOLARHAND_ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS — comma-separated origins allowed to call the API (the frontends).
SOLARHAND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo (analytics phase). Free, no key required.
SOLARHAND_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
SOLARHAND_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# Telemetry gateway shared secret. Connected field devices (and the bundled
# device simulator) present this in the `X-Gateway-Key` header when POSTing to
# /telemetry. It gates machine ingestion only — user logins still use JWT.
# The dev default lets the simulator work out of the box; ROTATE for anything
# beyond local demo (any long random string works — see the JWT command above).
SOLARHAND_GATEWAY_KEY=dev-gateway-key-change-me
