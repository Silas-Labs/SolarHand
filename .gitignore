# ---- Python / FastAPI backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# SQLite dev databases
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/solarhand.db

# ---- Node / React frontend ----
node_modules/
.pnp
.pnp.js
/coverage
frontend/dist/
frontend/dev-dist/
frontend/build/
*.tsbuildinfo

# The unanchored Python 'lib/' rule above matches any dir named 'lib' at any
# depth, which would silently exclude the PWA's source library. Keep it tracked.
!frontend/src/lib/

# ---- Env / secrets ----
.env
.env.*
!.env.example
*.pem

# ---- Editor / OS ----
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# QA walkthrough throwaway screenshots
qa-visual/shots/
